{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gi.dev/protocol/spec/schemas/package-manifest.schema.json",
  "title": "Gi Package Manifest v1",
  "type": "object",
  "required": ["name", "version", "gi"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gi": {
      "$ref": "#/$defs/gi"
    }
  },
  "$defs": {
    "gi": {
      "type": "object",
      "required": ["manifestVersion"],
      "additionalProperties": true,
      "properties": {
        "manifestVersion": {
          "const": 1
        },
        "engines": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "gi": {
              "type": "string"
            },
            "gi-ext-rpc": {
              "type": "string"
            },
            "gi-viewtree": {
              "type": "string"
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/extension"
              }
            ]
          },
          "default": []
        },
        "skills": {
          "$ref": "#/$defs/resourceList"
        },
        "prompts": {
          "$ref": "#/$defs/resourceList"
        },
        "themes": {
          "$ref": "#/$defs/resourceList"
        },
        "assets": {
          "$ref": "#/$defs/resourceList"
        }
      }
    },
    "resourceList": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "required": ["id", "entry"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "entry": {
          "$ref": "#/$defs/entry"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "command", "transport", "protocol"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "process"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "transport": {
              "enum": ["stdio-ndjson"]
            },
            "protocol": {
              "enum": ["gi-ext-rpc@1"]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "symbol"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inprocess"
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
