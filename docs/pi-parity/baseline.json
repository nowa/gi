        "giPackages": [
          "gi-agent-core",
          "gi-agent-core/harness"
        ]
      },
      {
        "name": "tui",
        "piPackage": "packages/tui",
        "giPackages": [
          "gi-tui"
        ]
      },
      {
        "name": "coding",
        "piPackage": "packages/coding-agent",
        "giPackages": [
          "gi-coding-agent",
          "cmd/gi",
          "protocol"
        ]
